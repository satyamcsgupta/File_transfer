# Copy this file to .env for local development. Use platform secret settings in production.
APP_ENV=development
SECRET_KEY=replace-with-at-least-32-random-characters
VAULT_PASSWORD=replace-with-a-long-unique-password
SESSION_COOKIE_SECURE=false
MAX_CONTENT_LENGTH=104857600

# Point this at a persistent volume before starting the app in the cloud.
# VAULT_DATA_DIR=/path/to/persistent/vault-data
